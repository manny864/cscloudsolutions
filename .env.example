# Public (client) key for reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=PASTE_YOUR_SITE_KEY
# Secret key for reCAPTCHA v3 (server only)
RECAPTCHA_SECRET_KEY=PASTE_YOUR_SECRET_KEY
# Microsoft Graph authentication (Azure AD app)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-app-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
# Email configuration
AZURE_SENDER_EMAIL=sales@cscloudsolutions.com.ar
AZURE_RECIPIENT_EMAIL=sales@cscloudsolutions.com.ar